RewriteEngine On

# Rule khusus API RESTful: /api/mahasiswa/5 -> api/mahasiswa.php?id=5
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/mahasiswa/([0-9]+)/?$ api/mahasiswa.php?id=$1 [L,QSA]

# Rule khusus API RESTful: /api/mahasiswa -> api/mahasiswa.php (GET semua / POST tambah)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/mahasiswa/?$ api/mahasiswa.php [L,QSA]

# Rule MVC bawaan: semua request lain diarahkan ke front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
