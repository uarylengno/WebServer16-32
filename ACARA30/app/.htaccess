# Acara 30 (Langkah 4): lapisan pertahanan tambahan. Idealnya app/ berada di luar public_html sehingga tidak dapat
# dijangkau browser sama sekali; berkas ini menolak akses langsung bila app/ terlanjur berada di dalam folder web.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
